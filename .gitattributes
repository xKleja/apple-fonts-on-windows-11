# Default: LF everywhere (the build scripts run on macOS and break with CRLF).
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# PowerShell 5.1 and Windows tools expect CRLF; keep scripts consistent on every checkout.
*.ps1  text eol=crlf
*.wsb  text eol=crlf
*.cmd  text eol=crlf

*.png  binary
*.ttf  binary
*.otf  binary
*.ttc  binary
*.zip  binary
*.dmg  binary
*.pkg  binary
