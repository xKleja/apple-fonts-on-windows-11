root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Mirrors .gitattributes: PowerShell 5.1 and Windows tools expect CRLF.
[*.{ps1,wsb,cmd}]
end_of_line = crlf

[*.py]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated reports: keep them byte-for-byte as the tools wrote them.
[docs/reports/*.txt]
trim_trailing_whitespace = false
